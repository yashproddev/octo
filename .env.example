# Pooled connection — used by the application at runtime.
# Serverless spawns many short-lived invocations; the pooler endpoint is mandatory.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Direct (unpooled) connection — used by Alembic only.
# Same URL with "-pooler" removed from the host.
DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Comma-separated origins for local dev. Empty in production (single origin, no CORS).
CORS_ORIGINS=http://localhost:5173
